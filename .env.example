# Local OpenAI-compatible LLM (vLLM). In Docker Compose, use the internal service URL.
LOCAL_LLM_URL=http://vllm-backend:8000/v1
LOCAL_LLM_MODEL=nvidia/NVIDIA-Nemotron-3-Super-120B-A12B-FP8
LOCAL_LLM_API_KEY=local-no-key-required

# Hugging Face (required to download gated model weights)
HF_TOKEN=

# Optional: Cloudflare Tunnel (use profile: docker compose --profile tunnel up -d)
CLOUDFLARE_TUNNEL_TOKEN=
